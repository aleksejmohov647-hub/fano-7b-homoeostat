import numpy as np
from typing import Dict, Any

class ProjectiveFrame13Engine:
    """
    Алгебраический верификатор NoC-топологии (N=157) на базе регулярного 
    проективного фрейма Z13 и запрещенных подпространств инцидентностей Фано.
    """
    def __init__(self):
        self.v = 157
        # Строгая декомпозиция: 43 (6-й пор.) + 101 (суб-10-й пор.) + 13 (13-й пор.) = 157
        self.z43 = list(range(0, 43))       # Запрещенный 6-й порядок (!5 - !2)
        self.z101 = list(range(43, 144))    # Суб-выборка запрещенного 10-го порядка
        self.z13 = list(range(144, 157))    # Фрейм "Нового счета" (13 разрешенных точек)

    def build_matrix(self, p_weights: list, noise_level: float = 0.0) -> np.ndarray:
        """
        Конструирует комплексную Эрмитову матрицу смежности графа смешанной инцидентности.
        """
        A = np.zeros((self.v, self.v), dtype=np.complex128)
        
        # 1. Формирование базовой связности регулярных локальных колец
        for z in [self.z43, self.z101, self.z13]:
            sz = len(z)
            for i in range(sz):
                A[z[i], z[(i + 1) % sz]] = 1.0
                A[z[(i + 1) % sz], z[i]] = 1.0

        # 2. Наложение оператора хорд 12-го порядка и субфакториального наклона !5 = 44
        # Зона 43 (простое число, шаг 12 взаимно прост)
        for i in range(43):
            A[self.z43[i], self.z43[(i + 12) % 43]] = 1j
            A[self.z43[(i + 12) % 43], self.z43[i]] = -1j
            
        # Зона 101 (шаг 12 + сдвиг 44 -> итоговый шаг 56)
        for i in range(101):
            A[self.z101[i], self.z101[(i + 12 + 44) % 101]] = 1j
            A[self.z101[(i + 12 + 44) % 101], i] = -1j

        # 3. Вероятностные инцидентности Фано через регулярный фрейм Z13
        # Интегрируем граничные условия переключения высших запрещенных порядков (до 15)
        for idx, frame_node in enumerate(self.z13):
            p_current = p_weights[idx % len(p_weights)]
            
            # Асимметричный тернарный наклон переключения линков (масштабы 4 и 5)
            step_43 = 4 if idx % 2 == 0 else 5
            for step in range(0, 43, step_43):
                weight = p_current * 1j
                if noise_level > 0:
                    weight += np.random.normal(0, noise_level) * 1j
                A[frame_node, self.z43[step]] = weight
                A[self.z43[step], frame_node] = np.conj(weight)
                
            # Инцидентности макрозоны с шагом, кратным тринадному базису фрейма
            for step in range(0, 101, 13):
                weight = p_current
                if noise_level > 0:
                    weight += np.random.normal(0, noise_level)
                A[frame_node, self.z101[step]] = weight
                A[self.z101[step], frame_node] = np.conj(weight)

        return A

    def evaluate_spectrum(self, noise_level: float = 0.0) -> Dict[str, Any]:
        """
        Вычисляет собственные значения Эрмитова оператора смежности.
        """
        probabilities = [1.0/3.0, 1.0/2.0, 1.0] # Вероятностный базис от 0 до 8
        A = self.build_matrix(probabilities, noise_level)
        
        eg = np.linalg.eigvalsh(A)
        eg_abs = np.sort(np.abs(eg))[::-1]
        
        l0, l1 = eg_abs[0], eg_abs[1]
        ratio = l1 / l0 if l0 != 0 else 1.0
        
        return {
            "lambda_0_max": float(l0),
            "lambda_1_next": float(l1),
            "spectral_gap": float(l0 - l1),
            "harmonic_ratio": float(ratio),
            "topology_status": "FRAME_13_OPEN" if ratio < 0.95 else "STALL_RESONANCE"
        }

    def run_monte_carlo(self, iterations: int = 500, noise: float = 0.05) -> Dict[str, float]:
        """
        Оценивает устойчивость зазора к фазовым искажениям на кристалле.
        """
        ratios = []
        gaps = []
        probabilities = [1.0/3.0, 1.0/2.0, 1.0]
        
        for _ in range(iterations):
            A = self.build_matrix(probabilities, noise_level=noise)
            eg = np.linalg.eigvalsh(A)
            eg_abs = np.sort(np.abs(eg))[::-1]
            ratios.append(eg_abs[1] / eg_abs[0])
            gaps.append(eg_abs[0] - eg_abs[1])
            
        return {
            "mc_mean_ratio": float(np.mean(ratios)),
            "mc_max_ratio": float(np.max(ratios)),
            "mc_mean_gap": float(np.mean(gaps)),
            "stability_index": "HIGHLY_STABLE" if np.max(ratios) < 0.95 else "VULNERABLE"
        }

if __name__ == "__main__":
    engine = ProjectiveFrame13Engine()
    print("=================== РЕЗУЛЬТАТЫ СИНТЕЗА ФРЕЙМА 13-ГО ПОРЯДКА ===================")
    print("--- [ЭТАП 1]: ВЕЩЕСТВЕННЫЙ СПЕКТРАЛЬНЫЙ АНАЛИЗ ОПЕРАТОРА ---")
    for k, v in engine.evaluate_spectrum().items():
        print(f"{k}: {v:.4f}" if isinstance(v, float) else f"{k}: {v}")
        
    print("\n--- [ЭТАП 2]: СТРЕСС-ТЕСТ МОНТЕ-КАРЛО (ФАЗОВЫЙ ШУМ 5%) ---")
    for k, v in engine.run_monte_carlo().items():
        print(f"{k}: {v:.4f}" if isinstance(v, float) else f"{k}: {v}")
