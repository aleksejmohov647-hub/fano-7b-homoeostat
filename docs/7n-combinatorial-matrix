\section{Первичные Объекты: $\mathbb{F}_1$, Субфакториалы и Геометрия Фано}

\begin{definition}
\emph{Поле с одним элементом} $\mathbb{F}_1$ --- формальный алгебраический объект, для которого группа автоморфизмов проективного пространства удовлетворяет изоморфизму $\Aut_{\mathbb{F}_1}(\mathbb{P}^{n-1}(\mathbb{F}_1)) \cong S_n$. Данное соответствие мотивировано тем, что предельная группа Ли $GL_n(\mathbb{F}_1) \cong S_n$ в канонической теории Титса.
\end{definition}

\begin{definition}
\emph{Субфакториал} (число беспорядков, деранжирование) определяется как:
\begin{equation}
\mathopen{!}n = n!\sum_{k=0}^{n}\frac{(-1)^k}{k!}.
\end{equation}
\end{definition}

\begin{proposition}\label{prop:subfac_vals}
Точные значения субфакториалов для контрольных масштабов $n \in \{7, 8, 12, 13, 14\}$ составляют:
\begin{equation}
\begin{aligned}
\mathopen{!}7 &= 1854, & \mathopen{!}8 &= 14\,833, \\
\mathopen{!}12 &= 176\,214\,841, & \mathopen{!}13 &= 2\,290\,792\,932, \\
\mathopen{!}14 &= 32\,071\,101\,049. & &
\end{aligned}
\end{equation}
\end{proposition}
\begin{proof} Прямое вычисление по комбинаторной формуле (1). \end{proof}

\begin{proposition}\label{prop:limit_e}
$\displaystyle\lim_{n\to\infty}\frac{\mathopen{!}n}{n!}=\frac{1}{e}$.
\end{proposition}
\begin{proof}
Отношение $\mathopen{!}n/n! = \sum_{k=0}^{n}(-1)^k/k!$ представляет собой частичную сумму ряда Тейлора для функции $e^{-1}$ в точке $x=-1$.
\end{proof}

\begin{proposition}\label{prop:fano_prop}
Размерность группы автоморфизмов плоскости Фано $\Aut(PG(2,\mathbb{F}_2)) \cong \mathrm{PSL}_2(7)$ равна $168$. Отношение $7!/168 = 30$.
\end{proposition}
\begin{proof} Плоскость Фано имеет 7 точек и 7 прямых; её полная группа автоморфизмов изоморфна простой группе $\mathrm{PSL}_2(7)$ порядка $168 = 8 \cdot 3 \cdot 7$. \end{proof}

\section{Полином $N(q)$ и Каскадная Декомпозиция Симметрий}

\begin{definition}
$N(q) = q^2 + q + 1$ --- число точек и прямых проективной плоскости порядка $q$.
\end{definition}

Вместо изолированного анализа фиксированных симметрий, метатопос $7n/M$ постулирует наличие каскадной иерархии вложенных знакопеременных групп $A_n$ и симметрических групп $S_n$, чьи порядки переливаются через разности полиномов $N(q)$.

\begin{proposition}\label{prop:cascade}
Порядки групп микро-, мезо- и макромасштабов строго разлагаются по каркасам $N(q)$:
\begin{align}

|A_5| &= 60 = N(6) + N(3) + \frac{1}{2}|S_4| \nonumber\\
      &= 43 + 13 + 4, \\

|A_6| &= 360 = N(12) + N(10) + N(6) + N(3) + \frac{3}{2}|S_4| \nonumber\\
      &= 157 + 111 + 43 + 13 + 36.
\end{align}
\end{proposition}
\begin{proof}
Прямой расчет полиномов: $N(12)=157$, $N(10)=111$, $N(6)=43$, $N(3)=13$. Для симметрической группы $|S_4|=24$. Подстановка дает: $43+13+4=60=|A_5|$ и $157+111+43+13+36=360=|A_6|$.
\end{proof}

\begin{remark}
Группа $A_6$ является единственной знакопеременной группой, у которой внешняя группа автоморфизмов $\Out(A_n) \cong \mathbb{Z}_2$. Этот структурный дефект симметрии необходим для индукции топологической эверсии знака на полупериоде автомата.
\end{remark}

\begin{proposition}\label{prop:meso_7}
Субфакториал макромасштаба $\mathopen{!}7 = 1854$ балансируется половинным порядком $A_7$ и дефектом граничных слоев:
\begin{equation}
\mathopen{!}7 = 1854 = \frac{1}{2}|A_7| + 11 \cdot [N(14) - N(12)],
\end{equation}
где $N(14) - N(12) = 211 - 157 = 54$, а $\frac{1}{2}|A_7| = 1260$.
