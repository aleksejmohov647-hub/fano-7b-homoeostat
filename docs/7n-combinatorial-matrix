\section{$\mathbb{F}_2$-коллапс комбинаторного ранга}

\begin{lemma}\label{lem:f2}
Для любого нечётного порядка $n$ в точке $s=1$ модулярная редукция даёт матрицу единиц: $\hat{\mathbf P}^{(n)}\bmod 2 = \mathbf{J}$, откуда $\Rank_{\mathbb{F}_2}(\hat{\mathbf P}^{(n)}\bmod 2)=1$.
\end{lemma}
\begin{proof}

При $s=1 \equiv 1 \pmod 2$. Внедиагональные элементы равны $-1/n$. Так как $n$ нечётно, его мультипликативный обратный элемент $n^{-1} \equiv 1 \pmod 2$. Поскольку $-1 \equiv 1 \pmod 2$, все элементы матрицы становятся тождественно равны $1 \pmod 2$. Ранг матрицы $\mathbf{J}$, состоящей из неотличимых строк, над любым полем равен $1$.
\end{proof}
\begin{corollary}\label{cor:f2-157}
For макромасштаба $n=157$ получаем $\Rank_{\mathbb{F}_2}(\hat{\mathbf P}^{(157)}\bmod2)=1$.
\end{corollary}
\begin{corollary}\label{cor:f2-kron}
Для кронекерова произведения на мезоуровне: $\Rank_{\mathbb{F}2}(\hat{\mathbf P}^{(7)}\otimes\hat{\mathbf P}^{(13)}\bmod2)=\Rank{\mathbb{F}2}(\mathbf{J}{91})=1$.
\end{corollary}
