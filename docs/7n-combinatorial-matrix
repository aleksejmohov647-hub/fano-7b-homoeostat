\section{Спектральный оператор $\hat{\mathbf P}^{(n)}$}

\begin{definition}
Линейный оператор деформации задается матрицей $\hat{\mathbf P}^{(n)}_{ij}=s\,\delta_{ij}-\frac{1}{n}(1-\delta_{ij})$. Её диагональные элементы равны $s$, а внедиагональные составляют $(-1/n)$.
\end{definition}

\begin{proposition}\label{prop:eig}
Собственные значения спектрального оператора $\hat{\mathbf P}^{(n)}$ имеют вид:
\begin{equation}
\lambda_{\min}=s-\frac{n-1}{n}\quad(\text{кратность }1),\qquad\lambda_{\mathrm{reg}}=s+\frac{1}{n}\quad(\text{кратность }n-1).
\end{equation}
\end{proposition}
\begin{proof}
Оператор представляется в форме $\hat{\mathbf P}^{(n)}=\left(s+\frac{1}{n}\right)\mathbf{I}-\frac{1}{n}\mathbf{J}$, где $\mathbf{I}$ --- единичная матри, а $\mathbf{J}$ --- матрица из одних единиц. Собственные значения матрицы $\mathbf{J}$ равны $n$ (для собственного вектора $\mathbf{1}$) и $0$ с кратностью $n-1$. Подстановка спектра $\mathbf{J}$ непосредственно доказывает (4).
\end{proof}

\begin{proposition}\label{prop:sing}
При критическом параметре $s_{\mathrm{crit}}=\frac{n-1}{n}$ спектральное значение $\lambda_{\min}=0$, и матрица $\hat{\mathbf P}^{(n)}$ становится сингулярной.
\end{proposition}

\begin{proposition}\label{prop:det157}
В канонической точке деформации $s=1$ для макромасштаба $n=157$:
\begin{equation}
\det\hat{\mathbf P}^{(157)}=\frac{158^{156}}{157^{157}}.
\end{equation}
\end{proposition}
\begin{proof}
Согласно формуле (4), при $s=1$ получаем $\lambda_{\min}=\frac{1}{157}$ и $\lambda_{\mathrm{reg}}=\frac{158}{157}$ с кратностью $156$. Определитель равен произведению собственных значений: $\det = \left(\frac{1}{157}\right) \times \left(\frac{158}{157}\right)^{156} = \frac{158^{156}}{157^{157}}$.
\end{proof}

