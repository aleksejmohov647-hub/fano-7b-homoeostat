\section{Первичные объекты: $\mathbb{F}_1$, субфакториалы, плоскость Фано}

\begin{definition}
\emph{Поле с одним элементом} $\mathbb{F}_1$ --- формальный алгебраический объект, для которого группа автоморфизмов проективного пространства $\Aut_{\mathbb{F}_1}(\mathbb{P}^{n-1}(\mathbb{F}_1)) \cong S_n$. Это соответствие мотивировано тем, что предельная группа Ли $GL_n(\mathbb{F}_1) \cong S_n$ в канонической теории Титса.
\end{definition}

\begin{definition}
\emph{Субфакториал} (число беспорядков, derangement) определяется как:
\begin{equation}
\mathopen{!}n = n!\sum_{k=0}^{n}\frac{(-1)^k}{k!}.
\end{equation}
\end{definition}

\begin{proposition}\label{prop:subfac}
Точные значения субфакториалов для макромасштабов $n\in\{7,8,12,13,14\}$:
\begin{equation}
\begin{aligned}
\mathopen{!}7 &= 1854, & \mathopen{!}8 &= 14\,833, & \mathopen{!}12 &= 176\,214\,841,\\
\mathopen{!}13 &= 2\,290\,792\,932, & \mathopen{!}14 &= 32\,071\,101\,049.
\end{aligned}
\end{equation}
\end{proposition}
\begin{proof} Прямое вычисление по комбинаторной формуле (1). \end{proof}

\begin{proposition}\label{prop:limit}
$\displaystyle\lim_{n\to\infty}\frac{\mathopen{!}n}{n!}=\frac{1}{e}$.
\end{proposition}
\begin{proof}
Отношение $\mathopen{!}n/n! = \sum_{k=0}^{n}(-1)^k/k!$ представляет собой частичную сумму бесконечного ряда Тейлора для функции $e^{-1}$ в точке $x=-1$.
\end{proof}

\begin{proposition}\label{prop:fano}
$|\Aut(PG(2,\mathbb{F}_2))|=|\mathrm{PSL}_2(7)|=168$. Отношение $7!/168=30$.
\end{proposition}
\begin{proof} Классический результат проективной геометрии: плоскость Фано имеет $7$ точек и $7$ прямых; её полная группа автоморфизмов изоморфна простой группе $\mathrm{PSL}_2(7)$ порядка $168=8\cdot3\cdot7$. \end{proof}

